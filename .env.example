# Salin file ini menjadi .env.local lalu isi nilainya.
# Dapatkan API key di https://aistudio.google.com/
# JANGAN gunakan prefix NEXT_PUBLIC_ agar key tidak bocor ke bundle klien.
GEMINI_API_KEY=

# (Opsional) Ganti model tanpa edit kode. Default: gemini-flash-lite-latest
# Alternatif: gemini-flash-latest (lebih pintar, lebih lambat)
GEMINI_MODEL=

# Koneksi Supabase (PostgreSQL ter-host) untuk Prisma.
# Ambil dari Supabase Dashboard → Project Settings → Database → Connection string.
#
# DATABASE_URL  = koneksi POOLED (Transaction pooler / PgBouncer, port 6543).
#                 Wajib akhiri dengan ?pgbouncer=true. Dipakai runtime aplikasi.
# DIRECT_URL    = koneksi LANGSUNG (port 5432). Dipakai Prisma untuk migrasi.
#
# Ganti [PROJECT-REF], [PASSWORD], dan [REGION] sesuai proyek Supabase-mu.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
